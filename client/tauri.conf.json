{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shtorka",
  "version": "0.1.0",
  "identifier": "ru.shtorka.client",
  "build": {
    "frontendDist": "ui",
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Шторка",
        "width": 900,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}