{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shtorka Server",
  "version": "0.0.1-alpha",
  "identifier": "ru.shtorka.server",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Шторка — сервер",
        "width": 960,
        "height": 640,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}